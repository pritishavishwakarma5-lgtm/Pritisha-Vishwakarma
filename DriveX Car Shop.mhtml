@charset "utf-8";

* { margin: 0px; padding: 0px; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { font-family: Arial, sans-serif; background: rgb(245, 245, 245); colo=
r: rgb(34, 34, 34); }

header { height: 75px; background: rgb(17, 17, 17); display: flex; align-it=
ems: center; justify-content: space-between; padding: 0px 7%; color: white;=
 }

.logo { font-size: 26px; font-weight: bold; }

nav { display: flex; gap: 35px; }

nav a { color: white; text-decoration: none; font-size: 16px; transition: 0=
.3s; }

nav a:hover { color: rgb(255, 59, 48); }

.header-btn, .shop-btn { border-width: medium; border-style: none; border-c=
olor: currentcolor; border-image: none; background: rgb(230, 57, 70); color=
: white; padding: 12px 25px; border-radius: 5px; cursor: pointer; font-weig=
ht: bold; }

.header-btn:hover, .shop-btn:hover { background: rgb(185, 28, 40); }

.banner { height: 600px; background: linear-gradient(rgba(0, 0, 0, 0.55), r=
gba(0, 0, 0, 0.55)) center center / cover, url("https://images.unsplash.com=
/photo-1492144534655-ae79c964c9d7?auto=3Dformat&fit=3Dcrop&w=3D1600&q=3D80"=
); display: flex; align-items: center; padding-left: 8%; }

.banner-content { max-width: 650px; color: white; }

.small-title { color: rgb(255, 77, 90); font-weight: bold; letter-spacing: =
3px; margin-bottom: 15px; }

.banner h1 { font-size: 65px; margin-bottom: 20px; }

.banner h1 span { color: rgb(230, 57, 70); }

.banner-content p { font-size: 18px; line-height: 1.7; margin-bottom: 25px;=
 }

.shop-btn { padding: 15px 35px; font-size: 16px; }

.section-title { text-align: center; margin-bottom: 45px; }

.section-title p { color: rgb(230, 57, 70); font-weight: bold; letter-spaci=
ng: 2px; }

.section-title h2 { font-size: 40px; margin-top: 10px; }

.cars { padding: 80px 7%; background: white; }

.car-container { display: grid; grid-template-columns: repeat(3, 1fr); gap:=
 30px; }

.car-card { background: white; border-radius: 12px; overflow: hidden; box-s=
hadow: rgba(0, 0, 0, 0.12) 0px 5px 25px; transition: 0.3s; }

.car-card:hover { transform: translateY(-10px); }

.car-card img { width: 100%; height: 230px; object-fit: cover; }

.car-info { padding: 25px; }

.car-info h3 { font-size: 25px; margin-bottom: 8px; }

.car-info p { color: rgb(119, 119, 119); margin-bottom: 18px; }

.details { display: flex; justify-content: space-between; font-size: 14px; =
margin-bottom: 20px; }

.car-info h4 { font-size: 22px; margin-bottom: 18px; }

.car-info button { width: 100%; padding: 12px; border-width: medium; border=
-style: none; border-color: currentcolor; border-image: none; background: r=
gb(17, 17, 17); color: white; border-radius: 5px; cursor: pointer; }

.car-info button:hover { background: rgb(230, 57, 70); }

.features { padding: 80px 7%; background: rgb(245, 245, 245); }

.feature-container { display: grid; grid-template-columns: repeat(3, 1fr); =
gap: 30px; }

.feature { background: white; padding: 40px 30px; text-align: center; borde=
r-radius: 10px; box-shadow: rgba(0, 0, 0, 0.08) 0px 5px 20px; }

.icon { font-size: 45px; margin-bottom: 20px; }

.feature h3 { font-size: 22px; margin-bottom: 12px; }

.feature p { color: rgb(102, 102, 102); line-height: 1.6; }

footer { background: rgb(17, 17, 17); color: white; padding: 60px 7% 20px; =
}

.footer-content { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 5=
0px; margin-bottom: 40px; }

.footer-content h2 { margin-bottom: 15px; }

.footer-content h3 { margin-bottom: 20px; }

.footer-content p { color: rgb(170, 170, 170); margin-bottom: 10px; }

.footer-content a { display: block; color: rgb(170, 170, 170); text-decorat=
ion: none; margin-bottom: 10px; }

.footer-content a:hover { color: white; }

.copyright { border-top: 1px solid rgb(51, 51, 51); padding-top: 20px; text=
-align: center; color: rgb(119, 119, 119); }

@media (max-width: 900px) {
  nav { gap: 15px; }
  .car-container, .feature-container { grid-template-columns: 1fr; }
  .banner h1 { font-size: 45px; }
  .footer-content { grid-template-columns: 1fr; }
}
