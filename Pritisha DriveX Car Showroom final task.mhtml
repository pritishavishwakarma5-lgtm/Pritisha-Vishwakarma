@charset "utf-8";

* { margin: 0px; padding: 0px; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { font-family: Arial, sans-serif; background: rgb(245, 245, 245); colo=
r: rgb(34, 34, 34); }

.navbar { height: 75px; background: rgb(17, 17, 17); display: flex; align-i=
tems: center; justify-content: space-between; padding: 0px 7%; position: st=
icky; top: 0px; z-index: 1000; }

.logo { font-size: 26px; font-weight: bold; color: white; }

.logo i { color: rgb(230, 57, 70); margin-right: 8px; }

.nav-links { display: flex; list-style: none; gap: 35px; }

.nav-links a { text-decoration: none; color: white; transition: 0.3s; }

.nav-links a:hover { color: rgb(230, 57, 70); }

.hero-banner { height: 600px; background: linear-gradient(rgba(0, 0, 0, 0.5=
5), rgba(0, 0, 0, 0.55)) center center / cover, url("https://images.unsplas=
h.com/photo-1492144534655-ae79c964c9d7?auto=3Dformat&fit=3Dcrop&w=3D1600&q=
=3D80"); display: flex; justify-content: center; align-items: center; text-=
align: center; }

.banner-content { max-width: 750px; color: white; }

.banner-content h1 { font-size: 60px; margin-bottom: 20px; }

.banner-content p { font-size: 19px; line-height: 1.7; margin-bottom: 30px;=
 }

.btn { display: inline-block; padding: 14px 35px; background: rgb(230, 57, =
70); color: white; text-decoration: none; border-radius: 5px; font-weight: =
bold; transition: 0.3s; }

.btn:hover { background: rgb(185, 28, 40); }

.products-section { padding: 80px 7%; background: white; }

.products-section h2 { text-align: center; font-size: 40px; margin-bottom: =
45px; }

.card-container { display: grid; grid-template-columns: repeat(4, 1fr); gap=
: 25px; }

.card { background: white; border-radius: 12px; overflow: hidden; box-shado=
w: rgba(0, 0, 0, 0.12) 0px 5px 20px; transition: 0.3s; }

.card:hover { transform: translateY(-10px); }

.card img { width: 100%; height: 230px; object-fit: cover; }

.card-info { padding: 22px; }

.card-info h3 { font-size: 22px; margin-bottom: 12px; }

.card-info p { color: rgb(119, 119, 119); line-height: 1.6; min-height: 50p=
x; margin-bottom: 15px; }

.price { display: block; font-size: 21px; font-weight: bold; margin-bottom:=
 15px; }

.card-btn { width: 100%; padding: 12px; border-width: medium; border-style:=
 none; border-color: currentcolor; border-image: none; background: rgb(17, =
17, 17); color: white; border-radius: 5px; cursor: pointer; font-weight: bo=
ld; }

.card-btn:hover { background: rgb(230, 57, 70); }

.site-footer { background: rgb(17, 17, 17); color: white; padding: 60px 7% =
0px; }

.footer-container { display: grid; grid-template-columns: 1fr 1.4fr 1fr; ga=
p: 50px; padding-bottom: 45px; }

.footer-box h3 { color: rgb(230, 57, 70); margin-bottom: 20px; }

.quick-links ul { list-style: none; }

.quick-links li { margin-bottom: 14px; }

.quick-links a { text-decoration: none; color: rgb(187, 187, 187); }

.quick-links a:hover { color: rgb(230, 57, 70); }

.quick-links i { margin-right: 8px; }

.rating-card { display: flex; align-items: center; gap: 18px; background: r=
gb(34, 34, 34); padding: 15px; border-radius: 10px; }

.rating-card img { width: 90px; height: 90px; object-fit: cover; border-rad=
ius: 8px; }

.rating-details h4 { margin-bottom: 8px; }

.stars { color: rgb(255, 193, 7); margin-bottom: 7px; }

.rating-details p { color: rgb(170, 170, 170); font-size: 13px; }

.contact-info p { color: rgb(187, 187, 187); line-height: 1.7; margin-botto=
m: 12px; }

.contact-info i { color: rgb(230, 57, 70); margin-right: 8px; }

.footer-bottom { border-top: 1px solid rgb(51, 51, 51); padding: 20px 0px; =
text-align: center; }

.footer-bottom p { color: rgb(119, 119, 119); }

@media (max-width: 1100px) {
  .card-container { grid-template-columns: repeat(2, 1fr); }
  .banner-content h1 { font-size: 48px; }
}

@media (max-width: 700px) {
  .nav-links { gap: 15px; }
  .nav-links a { font-size: 13px; }
  .logo { font-size: 20px; }
  .banner-content h1 { font-size: 38px; }
  .card-container { grid-template-columns: 1fr; }
  .footer-container { grid-template-columns: 1fr; }
}
